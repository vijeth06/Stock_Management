# Shared Blockchain Network Configuration
# Copy this file to .env and adjust values for your team's shared Fabric network

# Fabric Network Mode
# LOCAL: Fabric runs on localhost (docker-compose default)
# REMOTE: Fabric runs on a shared/remote server
FABRIC_NETWORK_MODE=LOCAL

# Fabric Host Configuration
# For LOCAL mode: use "localhost"
# For REMOTE mode: use the shared server's IP or hostname
FABRIC_HOST=localhost

# Fabric Ports (default Fabric ports)
FABRIC_PEER_PORT=7051
FABRIC_ORDERER_PORT=7050
FABRIC_ORDERER_HOST=localhost

# Fabric Discovery
# Set to false when connecting to a remote network
FABRIC_DISCOVERY_AS_LOCALHOST=true
FABRIC_DISCOVERY_ENABLED=false

# Gateway Configuration
PORT=3000
JWT_SECRET=campus-track-secret-key-2025
FILE_TOKEN_SECRET=production-file-token-secret

# S3/MinIO Configuration (optional)
S3_BUCKET=minio-bucket
S3_ENDPOINT=http://localhost:9000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Admin Credentials (auto-seeded on first login)
ADMIN_EMAIL=admin@kongu.edu
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Demo Administrator

# Fabric Identity
FABRIC_IDENTITY=admin
FABRIC_IDENTITY_PASSWORD=adminpw
