{
  "name": "asset-management-remote-network",
  "version": "1.0.0",
  "client": {
    "organization": "Org1",
    "connectionPolicy": {
      "timeout": {
        "peer": {
          "endorser": "300"
        },
        "orderer": "300"
      }
    }
  },
  "channels": {
    "assets": {
      "orderers": ["orderer.example.com"],
      "peers": {
        "peer0.org1.example.com": {}
      }
    }
  },
  "orderers": {
    "orderer.example.com": {
      "url": "grpc://${FABRIC_HOST}:${FABRIC_ORDERER_PORT}",
      "grpcOptions": {
        "ssl-target-name-override": "orderer.example.com"
      }
    }
  },
  "peers": {
    "peer0.org1.example.com": {
      "url": "grpc://${FABRIC_HOST}:${FABRIC_PEER_PORT}",
      "grpcOptions": {
        "ssl-target-name-override": "peer0.org1.example.com"
      }
    }
  },
  "organizations": {
    "Org1": {
      "mspid": "Org1MSP"
    }
  }
}
