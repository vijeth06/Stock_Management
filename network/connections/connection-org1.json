{
  "name": "asset-management-network",
  "version": "1.0.0",
  "client": {
    "organization": "Org1",
    "connectionPolicy": {
      "timeout": {
        "peer": {
          "endorser": "300"
        },
        "orderer": "300"
      }
    }
  },
  "channels": {
    "assets": {
      "orderers": ["orderer"],
      "peers": {
        "peer0.org1.example.com": {}
      }
    }
  },
  "orderers": {
    "orderer": {
      "url": "grpc://orderer.example.com:7050",
      "grpcOptions": {
        "ssl-target-name-override": "localhost"
      }
    }
  },
  "peers": {
    "peer0.org1.example.com": {
      "url": "grpc://peer0.org1.example.com:7051",
      "grpcOptions": {
        "ssl-target-name-override": "localhost"
      }
    }
  },
  "organizations": {
    "Org1": {
      "mspid": "Org1MSP",
      "peers": [
        "peer0.org1.example.com"
      ],
      "certificateAuthor": {
        "url": "http://localhost:7054",
        "cacert": "/network/crypto-config/ca-cert.pem",
        "httpOptions": {
          "timeout": "300"
        }
      }
    }
  }
}