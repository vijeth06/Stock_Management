FROM node:20-alpine

WORKDIR /app

# Copy root package.json for monorepo resolution
COPY package.json package-lock.json ./

# Copy gateway
COPY gateway/package*.json ./gateway/
COPY backend ./backend/
COPY chaincode ./chaincode/
COPY client ./client/
COPY network ./network/
COPY scripts ./scripts/
COPY docs ./docs/
COPY tests ./tests/

WORKDIR /app/gateway
RUN npm install -g && npm install

WORKDIR /app
CMD ["npm", "run", "gateway"]